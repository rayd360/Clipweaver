# Track the program and selected test inputs. Keep runtime records local.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/PROJECT-HANDOFF.md
!/CODE-MAP.md
!/CONTINUE-IN-NEW-CHAT.md
!/START-HERE.md
!/TESTED.md
!/Sources/
!/Sources/**
!/scripts/
!/scripts/**
!/skill/
!/skill/**
!/Assets/
/Assets/*
!/Assets/AppIcon.icns
!/tests/
/tests/*
!/tests/*.md
!/tests/verify_outputs.py
!/tests/realistic-runner/
/tests/realistic-runner/*
!/tests/realistic-runner/main.swift
!/tests/fixtures/
!/tests/fixtures/**

# Common local files and credentials, including within tracked directories.
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/.aws/
**/.ssh/
